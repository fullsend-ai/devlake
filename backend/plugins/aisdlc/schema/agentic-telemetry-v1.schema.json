{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic telemetry v1 usage summary",
  "description": "Reference producer contract for AISDLC ingestion. The consumer salvages valid fields from nonconforming summaries and logs diagnostics.",
  "type": "object",
  "required": ["schema", "pipeline", "run_id", "ci", "source", "totals", "by_model", "started_at", "finished_at", "raw"],
  "properties": {
    "schema": { "const": "agentic-telemetry/v1" },
    "pipeline": { "type": "string", "minLength": 1, "maxLength": 255 },
    "run_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 255 },
    "ci": {
      "type": ["object", "null"],
      "required": ["project", "pipeline_id", "job_id", "job_name", "job_url"],
      "properties": {
        "project": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_./-]{0,254}$" },
        "pipeline_id": { "$ref": "#/$defs/ciId" },
        "job_id": { "$ref": "#/$defs/ciId" },
        "job_name": { "type": ["string", "null"], "minLength": 1, "maxLength": 255 },
        "job_url": {
          "type": ["string", "null"],
          "maxLength": 1024,
          "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]+)?/[A-Za-z0-9_./-]+/-/jobs/[0-9]+$"
        }
      }
    },
    "source": { "enum": ["claude-otel", "fullsend-metrics", null] },
    "totals": {
      "anyOf": [
        { "type": "null" },
        {
          "allOf": [
            { "$ref": "#/$defs/modelUsage" },
            {
              "required": ["tool_calls", "turns", "user_prompts"],
              "properties": {
                "tool_calls": { "$ref": "#/$defs/count" },
                "turns": { "$ref": "#/$defs/count" },
                "user_prompts": { "$ref": "#/$defs/count" }
              }
            }
          ]
        }
      ]
    },
    "by_model": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}(@[0-9]{8})?(:[0-9]{1,3})?$" },
      "additionalProperties": { "$ref": "#/$defs/modelUsage" }
    },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "raw": {
      "type": "object",
      "propertyNames": { "enum": ["raw/claude-otel.jsonl.gz", "raw/fullsend-metrics.json.gz", "raw/fullsend-telemetry.jsonl.gz"] },
      "additionalProperties": {
        "type": "object",
        "required": ["bytes", "uncompressed_bytes", "sha256"],
        "properties": {
          "bytes": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
          "uncompressed_bytes": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
          "sha256": {
            "description": "SHA-256 of the cleaned, decompressed content.",
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "removed_attributes": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
        }
      }
    }
  },
  "$defs": {
    "ciId": { "type": ["string", "null"], "pattern": "^[0-9]{1,20}$" },
    "count": { "type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807 },
    "cost": {
      "type": ["number", "null"],
      "minimum": 0,
      "exclusiveMaximum": 1000000000000000000,
      "multipleOf": 0.000001
    },
    "modelUsage": {
      "type": "object",
      "required": ["cost_usd", "input_tokens", "output_tokens", "cache_read_tokens", "cache_creation_tokens", "reasoning_tokens", "api_requests"],
      "properties": {
        "cost_usd": { "$ref": "#/$defs/cost" },
        "input_tokens": { "$ref": "#/$defs/count" },
        "output_tokens": { "$ref": "#/$defs/count" },
        "cache_read_tokens": { "$ref": "#/$defs/count" },
        "cache_creation_tokens": { "$ref": "#/$defs/count" },
        "reasoning_tokens": { "$ref": "#/$defs/count" },
        "api_requests": { "$ref": "#/$defs/count" }
      }
    },
    "timestamp": {
      "description": "A calendar-valid ISO timestamp. Timezone-free values retain their source text but cannot be normalized to UTC. Calendar validity and endpoint ordering are checked by the consumer.",
      "type": ["string", "null"],
      "maxLength": 64,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-](0[0-9]|1[0-9]|2[0-3]):[0-5][0-9])?$"
    }
  }
}
